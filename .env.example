# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL — Dashboard > Project Settings > API (e.g. https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) — Dashboard > Project Settings > API Keys. Safe to ship in the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Personal access token for the Supabase CLI (link / db push) — supabase.com/dashboard/account/tokens.
# Not prefixed with VITE_, so it never ends up in the site bundle.
SUPABASE_ACCESS_TOKEN=
# Project reference (the "abcdefgh" in the project URL), used by `supabase link`.
SUPABASE_PROJECT_REF=

# Outgoing email goes through Resend (tembakehouse.com is verified there). These are NOT read by the
# site or the build: copy them into Supabase with `supabase secrets set` (see README → Email).
# Never prefix them with VITE_, or they would be bundled into the browser code.
RESEND_API_KEY=
# Optional overrides (these are the defaults)
# MAIL_FROM_NAME=Tem Bakehouse
# MAIL_FROM_EMAIL=no-reply@tembakehouse.com
# MAIL_REPLY_TO=contact@tembakehouse.com
# Optional: also send TEM a copy of every order email
ORDER_NOTIFY_TO=
